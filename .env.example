# Copy this file to .env.local and fill in your Supabase project values.
# Find these under Project Settings > API in your Supabase dashboard.
# .env.local is gitignored (matches *.local) so your keys never get committed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
